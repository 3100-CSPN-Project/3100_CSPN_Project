{
  "name": "cspn_sports",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/3100-CSPN-Project/3100_CSPN_Project#readme",
  "bugs": {
    "url": "https://github.com/3100-CSPN-Project/3100_CSPN_Project/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3100-CSPN-Project/3100_CSPN_Project.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:data && npm run test:dom",
    "gauntlet": "npm run typecheck && npm run test && npm run lint",
    "pretest:data": "node src/tests/data-layer/build-test-modules.mjs",
    "test:data": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --selectProjects db",
    "test:data:compare": "npm run test:data -- --verbose",
    "test:dom": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects dom",
    "test:mlb": "node --test scripts/mlb/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint . && npx prettier . -c",
    "lint:fix": "eslint . --fix",
    "ingest:mlb": "node --env-file-if-exists=.env scripts/mlb/import-2026.mjs",
    "sync:mlb-images": "node --env-file-if-exists=.env scripts/mlb/sync-images.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@jest/types": "^30.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cloudinary": "^2.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
